# Copiar a .env y completar con los valores reales (no commitear .env).

# Obligatorias — sin ellas src/lib/supabase.ts lanza un error y la app no carga
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-o-publishable-key>

# Opcional — si se omite, el frontend usa el mock local (src/lib/mockData.ts)
VITE_API_BASE_URL=http://localhost:3000

# Opcional — API key para autenticar ante el motor de reglas (header
# X-API-Key). Debe coincidir con una de las keys que el backend tiene en su
# propio API_KEYS. Sin ella, el request se manda sin el header y el backend
# lo rechaza si AUTH_ENABLED=true de su lado.
#
# Con prefijo VITE_ a propósito PERO src/lib/api.ts solo la lee en dev
# (npm run dev, sin runtime de Vercel Functions) para llamar al backend
# directo. En el build de producción el cliente llama same-origin a
# /api/shipments/* (frontend/api/shipments/*.ts), que lee esta misma
# variable del lado del servidor (Vercel expone todo el env a las Functions,
# el prefijo VITE_ solo controla qué se inlinea en el bundle) — la key nunca
# llega al JS servido a un visitante. Mismo motivo que GEMINI_API_KEY abajo.
VITE_X_API_KEY=

# Opcional — ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Sin ella, CookieConsentBanner no carga ningún script de analítica (el
# aviso de cookies igual se muestra para poder activarla más adelante sin
# tocar código, solo agregando esta variable).
VITE_GA_MEASUREMENT_ID=

# Requerida para el chat de ayuda (SupportChatWidget) — API key de Gemini
# (Google AI Studio, https://aistudio.google.com/apikey, tier gratuito).
# SIN prefijo VITE_ a propósito: la usa api/chat.ts del lado del servidor
# (Vercel Serverless Function), nunca debe llegar al bundle del cliente.
# En Vercel: Project Settings → Environment Variables. Localmente solo
# funciona corriendo `vercel dev` (npm run dev con Vite no sirve /api/*).
GEMINI_API_KEY=
